<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Venguard</AssemblyName>
    <RootNamespace>Venguard</RootNamespace>
    <ApplicationIcon>Assets\Venguard.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf"
                      Version="2.0.1" />

    <PackageReference Include="Windowstoastapi"
                      Version="1.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\VenguardLogo.png" />
    <Resource Include="Assets\Venguard.ico" />
  </ItemGroup>

</Project>