<Window x:Class="Venguard.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Venguard Settings"
        Width="560"
        Height="430"
        MinWidth="560"
        MinHeight="430"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource ForegroundBrush}"
        WindowStyle="None"
        ResizeMode="NoResize">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border Background="{StaticResource WindowBackgroundBrush}"
            BorderBrush="#333333"
            BorderThickness="1">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="72"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource TitleBarBrush}"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">

                <Grid>
                    <TextBlock Margin="16,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Text="Venguard Settings"/>

                    <Button Width="46"
                            Height="44"
                            HorizontalAlignment="Right"
                            Click="CloseButton_Click"
                            Content="×"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1"
                        Margin="48,32">

                <TextBlock FontSize="28"
                           FontWeight="SemiBold"
                           Text="Settings"/>

                <TextBlock Margin="0,8,0,28"
                           FontSize="14"
                           Opacity="0.7"
                           Text="Choose how Venguard behaves on your PC."/>

                <CheckBox x:Name="AutoStartCheckBox"
                          Margin="0,0,0,18"
                          FontSize="14"
                          Content="Start Venguard with Windows"/>

                <CheckBox x:Name="LaunchDiscordCheckBox"
                          Margin="0,0,0,18"
                          FontSize="14"
                          Content="Launch Discord after a successful repair"/>

                <CheckBox x:Name="OpenAsarCheckBox"
                          FontSize="14"
                          Content="Use OpenAsar when available"/>
            </StackPanel>

            <Border Grid.Row="2"
                    Background="{StaticResource TitleBarBrush}">

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">

                    <Button Width="100"
                            Height="38"
                            Margin="0,0,12,0"
                            Click="CancelButton_Click"
                            Content="Cancel"/>

                    <Button Width="100"
                            Height="38"
                            Margin="0,0,24,0"
                            Click="SaveButton_Click"
                            Content="Save"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>