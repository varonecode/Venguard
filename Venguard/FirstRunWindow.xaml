<Window x:Class="Venguard.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Venguard Setup"
        Width="520"
        Height="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="26"
                       FontWeight="SemiBold"
                       Text="Welcome to Venguard"/>

            <TextBlock Margin="0,8,0,0"
                       TextWrapping="Wrap"
                       Opacity="0.7"
                       Text="Venguard keeps your Discord Vencord installation healthy and gives you control over repair, OpenAsar, notifications, and startup behavior."/>
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Margin="0,28,0,0">

            <CheckBox x:Name="AutoStartCheckBox"
                      Margin="0,0,0,18"
                      Content="Start Venguard with Windows"/>

            <CheckBox x:Name="StartMinimizedCheckBox"
                      Margin="0,0,0,18"
                      Content="Start Venguard minimized to the system tray"/>

            <CheckBox x:Name="LaunchDiscordCheckBox"
                      Margin="0,0,0,18"
                      Content="Launch Discord after a successful repair"/>

            <CheckBox x:Name="UseOpenAsarCheckBox"
                      Content="Use OpenAsar when available"/>

        </StackPanel>

        <StackPanel Grid.Row="2"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">

            <Button Width="110"
                    Height="36"
                    Margin="0,0,10,0"
                    Click="CancelButton_Click"
                    Content="Cancel"/>

            <Button Width="110"
                    Height="36"
                    Click="ContinueButton_Click"
                    Content="Continue"/>

        </StackPanel>
    </Grid>
</Window>