<Window x:Class="Venguard.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Welcome to Venguard"
        Width="480"
        Height="440"
        MinWidth="480"
        MinHeight="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource ForegroundBrush}"
        WindowStyle="None"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border Margin="1"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="14">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Background="{StaticResource SurfaceElevatedBrush}"
                    CornerRadius="14,14,0,0"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="20,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="28" Height="28"
                                CornerRadius="7"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1">
                            <Image Source="/Venguard;component/Assets/VenguardLogo.png"
                                   Width="20" Height="20"
                                   Stretch="Uniform"/>
                        </Border>
                        <TextBlock Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Text="Welcome to Venguard"/>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Padding="28,24">
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitleStyle}"
                               FontSize="22"
                               Text="Quick setup"/>
                    <TextBlock Margin="0,8,0,24"
                               Style="{StaticResource PageSubtitleStyle}"
                               Text="Venguard keeps your Discord Vencord installation healthy. Choose your preferences below — you can change these anytime in Settings."/>

                    <CheckBox x:Name="AutoStartCheckBox"
                              Margin="0,0,0,14"
                              Content="Start Venguard with Windows"
                              Style="{StaticResource ThemedCheckBoxStyle}"/>
                    <CheckBox x:Name="StartMinimizedCheckBox"
                              Margin="0,0,0,14"
                              Content="Start minimized to the system tray"
                              Style="{StaticResource ThemedCheckBoxStyle}"/>
                    <CheckBox x:Name="LaunchDiscordCheckBox"
                              Margin="0,0,0,14"
                              Content="Launch Discord after a successful repair"
                              Style="{StaticResource ThemedCheckBoxStyle}"/>
                    <CheckBox x:Name="UseOpenAsarCheckBox"
                              Content="Use OpenAsar when available"
                              Style="{StaticResource ThemedCheckBoxStyle}"/>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Padding="20,14"
                    Background="{StaticResource SurfaceElevatedBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,14,14">
                <StackPanel HorizontalAlignment="Right"
                            Orientation="Horizontal">
                    <Button MinWidth="100" Height="36" Margin="0,0,8,0"
                            Click="CancelButton_Click"
                            Content="Cancel"
                            Style="{StaticResource SecondaryButtonStyle}"/>
                    <Button MinWidth="100" Height="36"
                            Click="ContinueButton_Click"
                            Content="Continue"
                            Style="{StaticResource PrimaryButtonStyle}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
