<Window x:Class="Venguard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Venguard"
        Icon="/Venguard;component/Assets/Venguard.ico"
        Width="1080"
        Height="700"
        MinWidth="960"
        MinHeight="600"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource ForegroundBrush}"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>

        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#090A10" Offset="0"/>
                    <GradientStop Color="#0C0A14" Offset="0.55"/>
                    <GradientStop Color="#090A10" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Ellipse Width="480"
                 Height="480"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Top"
                 Margin="0,-200,-100,0"
                 IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                    <GradientStop Color="#402A1060" Offset="0"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Border Margin="12"
                Background="#E80C0E16"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                SnapsToDevicePixels="True">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="52"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="#CC0A0B12"
                        CornerRadius="16,16,0,0"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">

                    <Grid Margin="16,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="32"
                                    Height="32"
                                    CornerRadius="8"
                                    Background="{StaticResource SurfaceElevatedBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1">
                                <Image Source="/Venguard;component/Assets/VenguardLogo.png"
                                       Width="24"
                                       Height="24"
                                       Stretch="Uniform"/>
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource ForegroundBrush}"
                                           Text="Venguard"/>
                                <TextBlock FontSize="10"
                                           Foreground="{StaticResource MutedForegroundBrush}"
                                           Text="Discord protection"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <Button Width="32" Height="32" Margin="2,0"
                                    Click="MinimizeButton_Click" Content="—"
                                    Style="{StaticResource WindowButtonStyle}"/>
                            <Button Width="32" Height="32" Margin="2,0"
                                    Click="MaximizeButton_Click" Content="□"
                                    Style="{StaticResource WindowButtonStyle}"/>
                            <Button Width="32" Height="32" Margin="2,0"
                                    Click="CloseButton_Click" Content="×"
                                    Style="{StaticResource WindowButtonStyle}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="#660A0B12"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,1,0"
                            CornerRadius="0,0,0,16">

                        <Grid Margin="14,20,14,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <TextBlock Margin="12,0,0,8"
                                           Style="{StaticResource SectionLabelStyle}"
                                           Text="NAVIGATION"/>

                                <Button x:Name="DashboardNavButton"
                                        Click="DashboardNavButton_Click"
                                        Style="{StaticResource SidebarButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Width="22" FontSize="14" Text="⌂"/>
                                        <TextBlock VerticalAlignment="Center" Text="Dashboard"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="SettingsNavButton"
                                        Click="SettingsNavButton_Click"
                                        Style="{StaticResource SidebarButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Width="22" FontSize="14" Text="⚙"/>
                                        <TextBlock VerticalAlignment="Center" Text="Settings"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <Border Grid.Row="2"
                                    Padding="14"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionLabelStyle}" Text="STATUS"/>
                                    <TextBlock x:Name="TrayStateText"
                                               Margin="0,8,0,0"
                                               FontSize="12"
                                               Foreground="{StaticResource SecondaryForegroundBrush}"
                                               TextWrapping="Wrap"
                                               Text="Close button → system tray"/>
                                    <Rectangle Height="1"
                                               Margin="0,10"
                                               Fill="{StaticResource BorderBrush}"/>
                                    <TextBlock x:Name="MonitorIntervalText"
                                               FontSize="11"
                                               Foreground="{StaticResource MutedForegroundBrush}"
                                               TextWrapping="Wrap"
                                               Text="Monitoring every 10 seconds"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Grid Grid.Column="1" Margin="32,28,32,24">

                        <Grid x:Name="DashboardView" Opacity="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Margin="0,0,0,24">
                                <TextBlock Style="{StaticResource PageTitleStyle}" Text="Dashboard"/>
                                <TextBlock Margin="0,6,0,0"
                                           Style="{StaticResource PageSubtitleStyle}"
                                           Text="Monitor Vencord and OpenAsar status, and repair Discord when needed."/>
                            </StackPanel>

                            <UniformGrid Grid.Row="1"
                                         Columns="2"
                                         Margin="0,0,0,20">

                                <Border Margin="0,0,10,0"
                                        Style="{StaticResource CardBorderStyle}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SectionLabelStyle}" Text="VENCORD"/>
                                        <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
                                            <Ellipse x:Name="VencordStatusDot"
                                                     Width="8" Height="8"
                                                     Fill="{StaticResource MutedForegroundBrush}"
                                                     VerticalAlignment="Center"/>
                                            <TextBlock x:Name="StatusText"
                                                       Margin="10,0,0,0"
                                                       FontSize="20"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource ForegroundBrush}"
                                                       Text="Checking..."/>
                                        </StackPanel>
                                        <TextBlock Margin="0,8,0,0"
                                                   FontSize="11"
                                                   Foreground="{StaticResource MutedForegroundBrush}"
                                                   Text="Discord Stable"/>
                                    </StackPanel>
                                </Border>

                                <Border Margin="10,0,0,0"
                                        Style="{StaticResource CardBorderStyle}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SectionLabelStyle}" Text="OPENASAR"/>
                                        <TextBlock x:Name="OpenAsarStatusText"
                                                   Margin="0,14,0,0"
                                                   FontSize="20"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource ForegroundBrush}"
                                                   Text="Checking..."/>
                                        <TextBlock Margin="0,8,0,0"
                                                   FontSize="11"
                                                   Foreground="{StaticResource MutedForegroundBrush}"
                                                   Text="Runtime optimization"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <Border Grid.Row="2"
                                    Style="{StaticResource CardBorderStyle}"
                                    Padding="28">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel>
                                        <TextBlock Style="{StaticResource CardTitleStyle}" Text="Repair center"/>
                                        <TextBlock Margin="0,4,0,0"
                                                   Style="{StaticResource CardDescriptionStyle}"
                                                   Text="Uses the official Vencord installer to restore your Discord installation."/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Center"
                                                MaxWidth="480">

                                        <ProgressBar x:Name="RepairProgressBar"
                                                     Width="280"
                                                     Margin="0,0,0,16"
                                                     IsIndeterminate="True"
                                                     Visibility="Collapsed"/>

                                        <Border Padding="16,12"
                                                Background="{StaticResource SurfaceElevatedBrush}"
                                                BorderBrush="{StaticResource BorderStrongBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10">
                                            <TextBlock x:Name="ProgressText"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       FontSize="12"
                                                       Foreground="{StaticResource SecondaryForegroundBrush}"
                                                       Text="Ready to repair."/>
                                        </Border>

                                        <TextBlock x:Name="ResultText"
                                                   Margin="0,12,0,0"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource PurpleBrightBrush}"
                                                   Visibility="Collapsed"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2"
                                                Margin="0,24,0,0"
                                                HorizontalAlignment="Center"
                                                Orientation="Horizontal">
                                        <Button x:Name="RepairButton"
                                                MinWidth="168"
                                                Height="40"
                                                Margin="0,0,10,0"
                                                Click="RepairButton_Click"
                                                Content="Repair Vencord"
                                                Style="{StaticResource PrimaryButtonStyle}"/>
                                        <Button x:Name="CancelRepairButton"
                                                MinWidth="120"
                                                Height="40"
                                                Click="CancelRepairButton_Click"
                                                Content="Cancel"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Visibility="Collapsed"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <Grid x:Name="SettingsView"
                              Visibility="Collapsed"
                              Opacity="1">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Margin="0,0,0,20">
                                <TextBlock Style="{StaticResource PageTitleStyle}" Text="Settings"/>
                                <TextBlock Margin="0,6,0,0"
                                           Style="{StaticResource PageSubtitleStyle}"
                                           Text="Configure startup, repairs, notifications, and monitoring."/>
                            </StackPanel>

                            <ScrollViewer Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel MaxWidth="720">

                                    <Border Style="{StaticResource CardBorderStyle}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="Behavior"/>
                                            <TextBlock Margin="0,4,0,18"
                                                       Style="{StaticResource CardDescriptionStyle}"
                                                       Text="Startup and window behavior."/>
                                            <CheckBox x:Name="AutoStartCheckBox" Margin="0,0,0,14"
                                                      Content="Start Venguard with Windows"
                                                      Style="{StaticResource ThemedCheckBoxStyle}"/>
                                            <CheckBox x:Name="StartMinimizedCheckBox" Margin="0,0,0,14"
                                                      Content="Start minimized to the system tray"
                                                      Style="{StaticResource ThemedCheckBoxStyle}"/>
                                            <CheckBox x:Name="MinimizeToTrayCheckBox" Margin="0,0,0,14"
                                                      Content="Minimize window to the system tray"
                                                      Style="{StaticResource ThemedCheckBoxStyle}"/>
                                            <CheckBox x:Name="CloseToTrayCheckBox"
                                                      Content="Close window to tray instead of exiting"
                                                      Style="{StaticResource ThemedCheckBoxStyle}"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Margin="0,14,0,0" Style="{StaticResource CardBorderStyle}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="Repair"/>
                                            <TextBlock Margin="0,4,0,18"
                                                       Style="{StaticResource CardDescriptionStyle}"
                                                       Text="How Venguard handles repairs."/>
                                            <CheckBox x:Name="ConfirmBeforeRepairCheckBox" Margin="0,0,0,14"
                                                      Content="Ask for confirmation before every repair"
                                                      Style="{StaticResource ThemedCheckBoxStyle}"/>
                                            <CheckBox x:Name="LaunchDiscordCheckBox" Margin="0,0,0,14"
                                                      Content="Launch Discord after a successful repair"
                                                      Style="{StaticResource ThemedCheckBoxStyle}"/>
                                            <CheckBox x:Name="OpenAsarCheckBox"
                                                      Content="Use OpenAsar when available"
                                                      Style="{StaticResource ThemedCheckBoxStyle}"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Margin="0,14,0,0" Style="{StaticResource CardBorderStyle}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="Notifications"/>
                                            <TextBlock Margin="0,4,0,18"
                                                       Style="{StaticResource CardDescriptionStyle}"
                                                       Text="Choose which events trigger alerts."/>
                                            <CheckBox x:Name="NotificationsCheckBox" Margin="0,0,0,14"
                                                      Content="Show Venguard notifications"
                                                      Style="{StaticResource ThemedCheckBoxStyle}"/>
                                            <CheckBox x:Name="NotifySuccessCheckBox" Margin="0,0,0,14"
                                                      Content="Notify when a repair succeeds"
                                                      Style="{StaticResource ThemedCheckBoxStyle}"/>
                                            <CheckBox x:Name="NotifyFailureCheckBox"
                                                      Content="Notify when a repair fails"
                                                      Style="{StaticResource ThemedCheckBoxStyle}"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Margin="0,14,0,0" Style="{StaticResource CardBorderStyle}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="Monitoring"/>
                                            <TextBlock Margin="0,4,0,18"
                                                       Style="{StaticResource CardDescriptionStyle}"
                                                       Text="Background checks for unpatched Discord."/>

                                            <CheckBox x:Name="BackgroundMonitoringCheckBox"
                                                      Content="Enable background monitoring"
                                                      Checked="BackgroundMonitoringCheckBox_Changed"
                                                      Unchecked="BackgroundMonitoringCheckBox_Changed"
                                                      Style="{StaticResource ThemedCheckBoxStyle}"/>

                                            <Border Margin="0,18,0,0"
                                                    Padding="16"
                                                    Background="{StaticResource SurfaceElevatedBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="10">
                                                <StackPanel>
                                                    <TextBlock Foreground="{StaticResource SecondaryForegroundBrush}"
                                                               FontSize="13"
                                                               Text="Check interval"/>
                                                    <TextBlock Margin="0,4,0,12"
                                                               FontSize="11"
                                                               Foreground="{StaticResource MutedForegroundBrush}"
                                                               Text="How often Venguard refreshes Discord status."/>
                                                    <ComboBox x:Name="MonitorIntervalComboBox"
                                                              Width="280"
                                                              HorizontalAlignment="Stretch"
                                                              SelectedValuePath="Tag"
                                                              Style="{StaticResource ThemedComboBoxStyle}"
                                                              ItemContainerStyle="{StaticResource ThemedComboBoxItemStyle}">
                                                        <ComboBoxItem Content="Every 5 seconds" Tag="5"/>
                                                        <ComboBoxItem Content="Every 10 seconds" Tag="10"/>
                                                        <ComboBoxItem Content="Every 15 seconds" Tag="15"/>
                                                        <ComboBoxItem Content="Every 30 seconds" Tag="30"/>
                                                        <ComboBoxItem Content="Every 1 minute" Tag="60"/>
                                                        <ComboBoxItem Content="Every 2 minutes" Tag="120"/>
                                                        <ComboBoxItem Content="Every 5 minutes" Tag="300"/>
                                                    </ComboBox>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <Border Margin="0,14,0,0" Style="{StaticResource CardBorderStyle}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="Maintenance"/>
                                            <TextBlock Margin="0,4,0,16"
                                                       Style="{StaticResource CardDescriptionStyle}"
                                                       Text="Troubleshooting and cleanup tools."/>
                                            <WrapPanel>
                                                <Button MinWidth="155" Height="36" Margin="0,0,8,8"
                                                        Click="OpenDataFolderButton_Click"
                                                        Content="Open data folder"
                                                        Style="{StaticResource SecondaryButtonStyle}"/>
                                                <Button MinWidth="155" Height="36" Margin="0,0,8,8"
                                                        Click="ClearLogsButton_Click"
                                                        Content="Clear debug logs"
                                                        Style="{StaticResource SecondaryButtonStyle}"/>
                                                <Button MinWidth="155" Height="36" Margin="0,0,8,8"
                                                        Click="ResetSettingsButton_Click"
                                                        Content="Reset settings"
                                                        Style="{StaticResource SecondaryButtonStyle}"/>
                                                <Button MinWidth="155" Height="36" Margin="0,0,8,8"
                                                        Click="UninstallButton_Click"
                                                        Content="Uninstall Venguard"
                                                        Style="{StaticResource SecondaryButtonStyle}"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>

                                </StackPanel>
                            </ScrollViewer>

                            <Border Grid.Row="2"
                                    Margin="0,16,0,0"
                                    Padding="16,12"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                <Grid>
                                    <TextBlock x:Name="SettingsResultText"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               Foreground="{StaticResource MutedForegroundBrush}"/>
                                    <StackPanel HorizontalAlignment="Right"
                                                Orientation="Horizontal">
                                        <Button MinWidth="96" Height="36" Margin="0,0,8,0"
                                                Click="CancelSettingsButton_Click"
                                                Content="Cancel"
                                                Style="{StaticResource SecondaryButtonStyle}"/>
                                        <Button MinWidth="96" Height="36"
                                                Click="SaveSettingsButton_Click"
                                                Content="Save changes"
                                                Style="{StaticResource PrimaryButtonStyle}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
