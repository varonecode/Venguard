<Window x:Class="Venguard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Venguard"
        Width="620"
        Height="420"
        MinWidth="620"
        MinHeight="420"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource ForegroundBrush}"
        WindowStyle="None"
        ResizeMode="CanResize">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border Background="{StaticResource WindowBackgroundBrush}"
            BorderBrush="#333333"
            BorderThickness="1">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource TitleBarBrush}"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">

                <Grid>
                    <TextBlock Margin="16,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Text="Venguard"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">

                        <Button Width="46"
                                Height="44"
                                Click="MinimizeButton_Click"
                                Content="—"/>

                        <Button Width="46"
                                Height="44"
                                Click="MaximizeButton_Click"
                                Content="□"/>

                        <Button Width="46"
                                Height="44"
                                Click="CloseButton_Click"
                                Content="×"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1"
                  Margin="48">

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <TextBlock HorizontalAlignment="Center"
                               FontSize="30"
                               FontWeight="SemiBold"
                               Text="Venguard"/>

                    <TextBlock x:Name="StatusText"
                               Margin="0,12,0,0"
                               HorizontalAlignment="Center"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Text="Checking Discord..."/>

                    <TextBlock x:Name="OpenAsarStatusText"
                               Margin="0,6,0,0"
                               HorizontalAlignment="Center"
                               FontSize="14"
                               Opacity="0.7"
                               Text="OpenAsar: —"/>

                    <ProgressBar x:Name="RepairProgressBar"
                                 Width="300"
                                 Height="6"
                                 Margin="0,24,0,0"
                                 IsIndeterminate="True"
                                 Visibility="Collapsed"/>

                    <TextBlock x:Name="ProgressText"
                               Width="380"
                               Margin="0,12,0,0"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               FontSize="13"
                               Opacity="0.7"
                               Visibility="Collapsed"/>

                    <TextBlock x:Name="ResultText"
                               Width="380"
                               Margin="0,10,0,0"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Opacity="0.9"
                               Visibility="Collapsed"/>

                    <Button x:Name="RepairButton"
                            Width="180"
                            Height="40"
                            Margin="0,24,0,0"
                            Click="RepairButton_Click"
                            Content="Repair Vencord"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>